# Required for Discord operation
DISCORD_BOT_TOKEN=

# Default free-tier candidate. Model quotas and availability are account-specific.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DEFAULT_PROVIDER=gemini
DEFAULT_MODEL=auto

# Optional paid providers. Set ALLOW_PAID_PROVIDERS=true only if you intend
# to use provider API billing. ChatGPT subscriptions do not include API credit.
ALLOW_PAID_PROVIDERS=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
XAI_API_KEY=
GROK_MODEL=

# Optional local Ollama endpoint (model must already be installed locally).
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=

# Optional feature and Discord access controls.
ENABLE_IMAGE_GENERATION=false
ENABLE_MESSAGE_CONTENT=false
ALLOWED_GUILD_IDS=
ALLOWED_CHANNEL_IDS=
BOT_ADMIN_IDS=
REPLYALL_CHANNEL_IDS=

# Request/session limits
MAX_INPUT_CHARS=2000
MAX_OUTPUT_TOKENS=1024
HISTORY_MESSAGES=20
HISTORY_CHARS=24000
MAX_SESSIONS=1000
IDLE_TTL_SECONDS=3600
MAX_CONCURRENT_REQUESTS=3
COOLDOWN_SECONDS=5
REQUEST_TIMEOUT_SECONDS=60

# Optional system instructions. system_prompt.txt is used when this is unset.
# SYSTEM_PROMPT=

# Deprecated key aliases remain accepted; use canonical *_API_KEY names above.
# GEMINI_KEY=
# OPENAI_KEY=
# CLAUDE_KEY=
# GROK_KEY=
# ADMIN_USER_IDS=
