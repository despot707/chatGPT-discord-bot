# Required to connect this bot to Discord. Store real secrets only in .env or
# your hosting provider's secret-variable settings; never commit them.
DISCORD_BOT_TOKEN=

# Default free-tier candidate. Account quotas and eligibility vary.
DEFAULT_PROVIDER=gemini
DEFAULT_MODEL=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional fallback providers. Only configured providers can be selected.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
FALLBACK_PROVIDERS=gemini,groq,openrouter,ollama
ENABLE_PROVIDER_FALLBACK=true
MAX_PROVIDER_ATTEMPTS=3
PROVIDER_ATTEMPT_TIMEOUT_SECONDS=20

# Optional local Ollama endpoint; install and start the model yourself.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=
# Set true only when the installed Ollama model supports image input.
OLLAMA_SUPPORTS_VISION=false

# Optional paid APIs. ChatGPT subscriptions do not include API credit.
# This gates OpenAI, Anthropic, and xAI; OpenRouter paid models are gated too.
ALLOW_PAID_PROVIDERS=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Optional reasoning effort: none, minimal, low, medium, high, xhigh, max.
# For budget chat with GPT-6 Luna, use none. Leave empty to use the model default.
# Strict mode always defaults to none; an explicit user reasoning request gets
# low effort with a separate 2,000-token total-output cap for that request only.
OPENAI_REASONING_EFFORT=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
XAI_API_KEY=
GROK_MODEL=
ENABLE_IMAGE_GENERATION=false

# Optional strict, shared API spending guard. All servers/users share one ledger.
# Requires OpenAI GPT-6 Luna. Other providers/model overrides and image generation
# are blocked while strict mode is enabled until their costs are bounded.
HARD_BUDGET_ENABLED=false
BUDGET_MONTHLY_USD=10
BUDGET_LUNA_USD=7
BUDGET_TIMEZONE=America/Los_Angeles
BUDGET_DATABASE_PATH=data/budget.sqlite3
# Existing project spend this calendar month BEFORE this ledger is activated.
# Blank means unknown: paid generation is blocked for the activation month.
# Set 0 only after verifying there really is no prior spend. Imported once.
BUDGET_OPENING_MONTH_SPEND_USD=

# Optional Tavily web search. Search is enabled automatically when a key is set;
# ENABLE_WEB_SEARCH can explicitly override that behavior.
TAVILY_API_KEY=
# ENABLE_WEB_SEARCH=true
ENABLE_WEB_BROWSING=true
# OpenAI Responses built-in search; uses your OpenAI key and incurs tool charges.
# The model decides when to search, with at most one tool call per answer.
ENABLE_OPENAI_WEB_SEARCH=false
WEB_MAX_BYTES=1000000
WEB_MAX_CHARS=12000

# Gaming: one host-owned Steam Web API key for visible game libraries.
# Parties and team balancing work without a Steam key or AI calls.
STEAM_API_KEY=
# Mount a persistent volume at /app/data on Railway to retain this database.
GAMING_DATABASE_PATH=data/gaming.sqlite3

# Discord access and message behavior.
ENABLE_MESSAGE_CONTENT=false
INTERACTION_CHANNEL_IDS=
# Empty INTERACTION_CHANNEL_IDS permits mentions in all allowed channels.
# Recent channel context requires Message Content Intent and Read Message History.
AUTOMATIC_CONTEXT_COUNT=10
REPLYALL_CHANNEL_IDS=
BOT_ADMIN_IDS=
ALLOWED_GUILD_IDS=
ALLOWED_CHANNEL_IDS=

# Saved conversations: public chat is shared within a channel or thread;
# private slash-command chat remains separate per user. Empty path disables saving.
# Mount /app/data on Railway to retain history across deployments.
CHAT_DATABASE_PATH=data/chat.sqlite3
CHAT_RETENTION_DAYS=30

# Request and in-memory session limits.
MAX_INPUT_CHARS=2000
MAX_OUTPUT_TOKENS=1024
HISTORY_MESSAGES=20
HISTORY_CHARS=24000
MAX_SESSIONS=1000
IDLE_TTL_SECONDS=3600
MAX_CONCURRENT_REQUESTS=3
COOLDOWN_SECONDS=5
REQUEST_TIMEOUT_SECONDS=60

# Optional system instructions. system_prompt.txt is used when this is unset.
# SYSTEM_PROMPT=

# Legacy aliases are still accepted but canonical names above are preferred.
# GEMINI_KEY=
# OPENAI_KEY=
# CLAUDE_KEY=
# GROK_KEY=
# ADMIN_USER_IDS=

# Local canonical game catalog; no member gaming-account login/API key required.
GAME_CATALOG_DATABASE_PATH=data/catalog.sqlite3
# Successful bot/avatar updates are remembered to avoid repeating them on restart.
BOT_BRANDING_STATE_PATH=data/branding-state.json
